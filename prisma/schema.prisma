generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum IntelligenceSourceKind {
  SATELLITE
  WEATHER
  HYDROLOGICAL_MODEL
  OFFICIAL_GAUGE
  IOT_SENSOR
  DAM_OPERATION
  CITIZEN_REPORT
  OFFICIAL_ADVISORY
}

enum ObservationQuality {
  GOOD
  SUSPECT
  STALE
  MISSING
  UNKNOWN
}

model User {
  id                  String              @id @default(cuid())
  email               String              @unique
  name                String?
  passwordHash        String
  plan                String              @default("FREE")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  locations           Location[]
  alerts              Alert[]
  reports             Report[]
  evidenceEvents      EvidenceEvent[]
  agencyCommandCases  AgencyCommandCase[] @relation("AgencyCommandCreator")
}

model Location {
  id             String          @id @default(cuid())
  name           String
  state          String
  latitude       Float
  longitude      Float
  createdAt      DateTime        @default(now())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts         Alert[]
  evidenceEvents EvidenceEvent[]
}

model Alert {
  id             String   @id @default(cuid())
  lastNotifiedAt DateTime?
  threshold      Int
  channels       String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId     String
  location       Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

model Report {
  id          String   @id @default(cuid())
  latitude    Float
  longitude   Float
  area        String
  waterLevel  String
  description String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model EvidenceEvent {
  id            String    @id @default(cuid())
  eventType     String
  occurredAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId    String?
  location      Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  riskScore     Float?
  riskLevel     String?
  modelLabel    String?
  assetType     String?
  actionCode    String?
  actionText    String?
  channel       String?
  deliveryState String?
  previousHash  String?
  eventHash     String    @unique
  metadata      Json?

  @@index([userId, occurredAt])
  @@index([locationId, occurredAt])
  @@index([eventType, occurredAt])
}

model IntelligenceSource {
  id                      String                    @id @default(cuid())
  slug                    String                    @unique
  provider                String
  name                    String
  sourceKind              IntelligenceSourceKind
  description             String?
  active                  Boolean                   @default(true)
  defaultFreshnessMinutes Int
  config                  Json?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  observations            IntelligenceObservation[]
  credentials             IntelligenceCredential[]
}

model IntelligenceCredential {
  id         String             @id @default(cuid())
  name       String
  keyPrefix  String
  keyHash    String             @unique
  scopes     Json
  active     Boolean            @default(true)
  createdAt  DateTime           @default(now())
  lastUsedAt DateTime?
  sourceId   String
  source     IntelligenceSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, active])
}

model IntelligenceObservation {
  id               String               @id @default(cuid())
  sourceId         String
  source           IntelligenceSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  variable         String
  value            Json
  unit             String
  observedAt       DateTime
  receivedAt       DateTime
  latitude         Float
  longitude        Float
  locationName     String?
  state            String?
  country          String?
  qualityStatus    ObservationQuality   @default(UNKNOWN)
  confidence       Float?
  flags            Json?
  sourceVersion    String?
  externalRecordId String?
  originalUnit     String?
  originalVariable String?
  metadata         Json?
  dedupeKey        String               @unique
  createdAt        DateTime             @default(now())
  commandCase      AgencyCommandCase?

  @@index([sourceId, observedAt])
  @@index([variable, observedAt])
  @@index([latitude, longitude, observedAt])
}

/// Operational handling record for an immutable authenticated official advisory.
/// The source observation is never edited; this records the agency response lifecycle.
model AgencyCommandCase {
  id              String                  @id @default(cuid())
  observationId   String                  @unique
  observation     IntelligenceObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  status          String                  @default("RECEIVED")
  priority        String                  @default("NORMAL")
  notes           String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  acknowledgedAt  DateTime?
  escalatedAt     DateTime?
  resolvedAt      DateTime?
  createdByUserId String
  createdBy       User                    @relation("AgencyCommandCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
  @@index([priority, updatedAt])
}
